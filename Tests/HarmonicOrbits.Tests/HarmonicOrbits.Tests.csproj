<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <!-- No KSP or Unity references; compiling Model/ here enforces the boundary. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>HarmonicOrbits.Tests</AssemblyName>
    <RootNamespace>HarmonicOrbits.Verification</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../HarmonicOrbits/Model/*.cs">
      <Link>production/%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
